    <!-- Help (BR-08). -->
    <string name="help_title">Help</string>
    <string name="help_sending">Sending</string>
    <string name="help_sending_intro">What you send with Enter joins one growing message, live for everyone, until you start a new one.</string>
    <string name="help_enter">Sends what you wrote. Keep typing and press Enter again: it joins the same message.</string>
    <string name="help_new_line_keys">Shift + Enter, or New line</string>
    <string name="help_new_line">A new line in the box. Nothing is sent.</string>
    <string name="help_finish_keys">Ctrl + Enter, or Enter ×3</string>
    <string name="help_finish_brief">Finishes your current message and starts a new one.</string>
    <string name="help_finish">Finishes your current message and starts a new one. If nobody has replied to your message yet, there will be a longer delay before you are allowed to create a new message.</string>
    <string name="help_signs">Links and suggestions</string>
    <string name="help_signs_intro">At the start of a word, these signs open a list of suggestions while you type: tap one.</string>
    <string name="help_sign_user">username</string>
    <string name="help_sign_user_text">Mentions someone: they are notified and follow the topic, unless they unfollowed it.</string>
    <string name="help_sign_role">role</string>
    <string name="help_sign_role_text">Notifies everyone with that role who can read the topic. Which roles you may tag is set by the administrators.</string>
    <string name="help_sign_topic">topic</string>
    <string name="help_sign_topic_text">Links to a topic; once sent, it reads the topic\'s title.</string>
    <string name="help_sign_category">category</string>
    <string name="help_sign_category_text">Links to a category.</string>
    <string name="help_sign_tag">tag</string>
    <string name="help_sign_tag_text">Links to the topics with that tag.</string>
    <string name="help_sign_forum">forum</string>
    <string name="help_sign_forum_text">Links to another forum you joined, when the forums directory lists it; once sent, it reads the forum\'s name.</string>
    <string name="help_sign_command">command</string>
    <string name="help_sign_command_text">Runs a command, listed below. What you typed for it leaves the box.</string>
    <string name="help_commands">Commands</string>
    <string name="help_commands_intro">Type ! at the start of a word in the box under a topic, then pick a command. The list shows the ones you may use there.</string>
    <string name="help_plugins">Plugins on this server</string>
    <string name="help_plugins_intro">Administrators choose which roles may use each one.</string>
    <string name="help_spoilers">Hiding part of a message</string>
    <string name="help_spoiler_syntax">||text||</string>
    <string name="help_spoiler_text">Hides those words until each reader taps them. Quotes, search results and notifications show (spoiler) instead. To hide the whole message, use !spoiler.</string>
    <string name="help_formatting">Formatting text</string>
    <string name="help_formatting_intro">Messages are written in Markdown: type these signs around or before your words. They show as below once sent; @, +, #, /, $ and &amp; links are above.</string>
    <string name="format_bold">Bold.</string>
    <string name="format_bold_word">bold</string>
    <string name="format_italics">Italics. One underscore on each side works too.</string>
    <string name="format_italics_word">italics</string>
    <string name="format_strike">Struck through.</string>
    <string name="format_strike_word">struck through</string>
    <string name="format_highlight">Highlighted.</string>
    <string name="format_highlight_word">highlighted</string>
    <string name="format_superscript">Superscript: everything between the two ^ is raised, spaces included.</string>
    <string name="format_small">Small text, greyed out: at the start of a line, with a space after the #.</string>
    <string name="format_small_word">small text</string>
    <string name="format_spoiler">A spoiler: hidden in a topic until each reader taps it. To hide the whole message, use !spoiler.</string>
    <string name="format_spoiler_word">hidden words</string>
    <string name="format_code">Code, kept exactly as typed.</string>
    <string name="format_code_word">code</string>
    <string name="format_code_block">A block of code: ``` on a line before it and after it.</string>
    <string name="format_code_block_words">code on\nseveral lines</string>
    <string name="format_quote">A quote, at the start of a line.</string>
    <string name="format_quote_word">quoted text</string>
