<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: asked only once the member has posted or followed a topic (NT-07). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- UnifiedPush (NT-02): the distributor's endpoints and the forums' pushes. -->
        <service
            android:name=".IdejoPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
