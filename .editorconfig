root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 100
# Composables are named like types (PascalCase).
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose rules (io.nlopez.compose.rules): the theme object is IdejoTheme.
compose_allowed_composition_locals = LocalIdejoColors,LocalIdejoTypography

[*.{yml,yaml,toml,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
